.venv/
.venv_sky130/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Temporary / scratch files
*.tmp
*.bak
*.lock
*.temp
temp/
tmp/
scratch/

# Python packaging
build/
dist/
*.egg-info/

# Local development archives / backups
archive/
archive_private/
backup/
backups/

# Local PDK / tool installations
pdk/
sky130A/
Efabless_sky130/

